@model IEnumerable<MOM_Project.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary fw-bold">Departments</h2>
        <p class="text-muted">Manage the departments in your organization.</p>
    </div>
    <a asp-action="AddEdit" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill"></i> Add New Department
    </a>
</div>

<div class="card shadow border-0 rounded-3">
    
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
        <h6 class="m-0 font-weight-bold text-primary">All Departments</h6>
        
        <form asp-action="Index" method="post" class="m-0">
            <div class="input-group shadow-sm" style="max-width: 400px; border-radius: 0.75rem; overflow: hidden;">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control premium-input border-0" placeholder="Search..." aria-label="Search">
                
                <button class="btn btn-primary px-4 fw-bold" type="submit">
                    <i class="bi bi-search"></i>
                </button>
                
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                {
                    <a asp-action="Index" class="btn btn-light border-start text-danger px-3" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="card-body p-0 border-top">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase text-secondary small">
                <tr>
                    <th class="ps-4 py-3">ID</th>
                    <th class="py-3">Department Name</th>
                    <th class="py-3">Created Date</th>
                    <th class="py-3">Modified</th>
                    <th class="text-end pe-4 py-3">Actions</th>
                </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@item.DepartmentID</td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle px-2 py-1">
                                        @item.DepartmentName
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @(item.Created.HasValue ? item.Created.Value.ToString("dd MMM yyyy") : "N/A")
                                </td>
                                <td class="text-muted small">
                                    @(item.Modified.HasValue ? item.Modified.Value.ToString("dd MMM yyyy") : "N/A")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="AddEdit" asp-route-id="@item.DepartmentID" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.DepartmentID" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No departments found.</p>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <a asp-action="Index" class="btn btn-link btn-sm mt-2 text-decoration-none">Clear Search</a>
                    }
                </div>
            }
        </div>
    </div>
</div>