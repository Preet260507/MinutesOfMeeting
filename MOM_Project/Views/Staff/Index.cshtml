@model IEnumerable<MOM_Project.Models.Staff>
@{ ViewData["Title"] = "Staff Directory"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill me-2"></i>Staff Directory</h2>
            <p class="text-muted mb-0">Manage your team members and their roles.</p>
        </div>
    
        <div class="d-flex gap-2">
            <a asp-action="ExportToExcel" class="btn btn-success shadow-sm px-4 fw-bold d-flex align-items-center">
                <i class="bi bi-file-earmark-excel-fill me-2 fs-5"></i> Export to Excel
            </a>
        
            <a asp-action="AddEdit" class="btn btn-primary shadow-sm px-4 fw-bold d-flex align-items-center">
                <i class="bi bi-person-plus-fill me-2 fs-5"></i> Add Staff
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h6 class="m-0 font-weight-bold text-dark">All Staff Members</h6>
            
            <form asp-action="Index" method="get" class="m-0">
                <div class="input-group shadow-sm" style="max-width: 400px; border-radius: 0.75rem; overflow: hidden;">
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control premium-input border-0" placeholder="Search name, email, phone..." aria-label="Search">
                    <button class="btn btn-primary px-4 fw-bold" type="submit"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <a asp-action="Index" class="btn btn-light border-start text-danger px-3" title="Clear Search"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>

        <div class="card-body p-0 border-top">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Staff Name</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">Contact Info</th>
                            <th class="text-muted small py-3">Status</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.StaffName</div>
                                        <div class="small text-muted" style="font-size: 0.75rem;">ID: #@item.StaffID</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            <i class="bi bi-building me-1"></i> @item.DepartmentName
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="small"><i class="bi bi-envelope me-2 text-primary"></i> @(string.IsNullOrEmpty(item.EmailAddress) ? "-" : item.EmailAddress)</span>
                                            <span class="small"><i class="bi bi-phone me-2 text-success"></i> @(string.IsNullOrEmpty(item.MobileNo) ? "-" : item.MobileNo)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-muted" style="font-size: 0.75rem;">
                                            <div>Joined: @(item.Created.Year > 1 ? item.Created.ToString("MMM dd, yyyy") : "N/A")</div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="AddEdit" asp-route-id="@item.StaffID" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.StaffID" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-people display-4 mb-3 d-block opacity-25"></i>
                    <p class="mb-1">No staff members found.</p>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <a asp-action="Index" class="btn btn-link btn-sm mt-2 text-decoration-none">Clear Search</a>
                    }
                </div>
            }
        </div>
    </div>
</div>